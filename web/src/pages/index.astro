---
import '../styles/app.css';
import '../styles/workspace.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="A local investigation workspace for bounded Liquid UTXO tracing." />
    <title>Liquid Tracer · Local workspace</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to workspace</a>
    <div id="app"><main class="startup"><span class="spinner" aria-hidden="true"></span><h1>Opening your workspace</h1><p>Loading locally saved investigations…</p></main></div>
    <noscript><p class="noscript">Enable JavaScript to use the local interface. The terminal interface remains available with liquid-trace.</p></noscript>
    <dialog id="action-dialog" aria-labelledby="dialog-title"></dialog>
    <div id="notifications" class="notifications" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
